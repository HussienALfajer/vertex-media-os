# Non-secret Keycloak server options shared by infra/compose.yaml (env_file) and the API test
# harnesses (apps/api/test-support/keycloak.ts, apps/web-e2e/test-support/iam/stack.setup.ts). Plain
# KEY=VALUE lines only; no secrets here.

# Health and readiness on the management port (9000). The port is never published to the host.
KC_HEALTH_ENABLED=true

# Argon2id password hashing (docs/SECURITY.md Section 8; OWASP m=19 MiB, t=2, p=1). Iterations are
# set by the realm password policy (`hashIterations(2)`); the remaining parameters are server
# options. Production values are benchmarked on production hardware before launch.
KC_SPI_PASSWORD_HASHING__ARGON2__TYPE=id
KC_SPI_PASSWORD_HASHING__ARGON2__VERSION=1.3
KC_SPI_PASSWORD_HASHING__ARGON2__MEMORY=19456
KC_SPI_PASSWORD_HASHING__ARGON2__PARALLELISM=1
KC_SPI_PASSWORD_HASHING__ARGON2__HASH_LENGTH=32
