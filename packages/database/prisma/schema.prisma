// Vertex OS PostgreSQL schema (Prisma ORM 7).
//
// Phase 0 deliberately contains no models: business tables are owned by their
// domain modules and are introduced with their module specifications. The
// connection URL lives in `prisma.config.ts` (Prisma 7 configuration), never here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
