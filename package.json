{
  "name": "vertex-os",
  "version": "0.0.0",
  "private": true,
  "description": "Vertex OS — internal operating platform for Vertex Media (modular monolith workspace)",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p @vertex-os/api @vertex-os/web",
    "dev:api": "nx run @vertex-os/api:dev",
    "dev:web": "nx run @vertex-os/web:dev",
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "lint:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test:integration",
    "test:e2e": "nx run @vertex-os/web-e2e:e2e",
    "env:setup": "node scripts/setup-env.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "infra:reset": "docker compose --env-file .env -f infra/compose.yaml down --volumes",
    "db:validate": "nx run @vertex-os/database:prisma-validate",
    "db:generate": "nx run @vertex-os/database:prisma-generate",
    "db:migrate": "nx run @vertex-os/database:prisma-migrate-deploy",
    "openapi:generate": "nx run @vertex-os/api:openapi",
    "deps:audit": "pnpm audit --audit-level=moderate",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:boundaries && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm db:validate && pnpm db:generate && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/vite": "23.2.1",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "23.2.1",
    "prettier": "^3.9.8",
    "testcontainers": "12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
