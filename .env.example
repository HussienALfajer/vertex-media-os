# Vertex OS — local development environment template.
#
# Create `.env` with `pnpm env:setup`: it replaces every `<generated:NAME>` placeholder with a
# random value (one value per NAME) and, run again later, appends keys added here since without
# touching existing lines. `.env` is ignored by Git and MUST NOT contain production values.
# Consumers:
#   POSTGRES_*   -> infra/compose.yaml (local PostgreSQL container)
#   DATABASE_URL -> apps/api (validated at startup) and packages/database (Prisma CLI)
#   API_*        -> apps/api, and the apps/web dev/preview proxy (API_HOST/API_PORT only)
#   LOG_LEVEL    -> apps/api
#   KEYCLOAK_*   -> infra/compose.yaml (local Keycloak and the realm import placeholders), and
#                   apps/api identity provisioning configuration (loadIdentityProvisioningConfig:
#                   issuer, provisioner client, invitation lifespan; no API entry reads it yet)
#   MAILPIT_PORT -> infra/compose.yaml (local mail sink web UI)
#
# Nx loads this file into the environment of every task. Do not set NODE_ENV here:
# a non-production NODE_ENV would turn production builds into development builds.
# The API defaults to `development`; deployments set NODE_ENV=production explicitly.

# --- Local PostgreSQL container (infra/compose.yaml) ---------------------------
POSTGRES_USER=vertex
POSTGRES_PASSWORD=<generated:postgres-password>
POSTGRES_DB=vertex_os
# Host port published on 127.0.0.1. Change it if 5432 is already in use locally.
POSTGRES_PORT=5432

# --- Application database connection -------------------------------------------
# Must match the POSTGRES_* values above when using the local container.
DATABASE_URL=postgresql://vertex:<generated:postgres-password>@127.0.0.1:5432/vertex_os

# --- API (apps/api) -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Interactive OpenAPI UI at /api/docs. Defaults to enabled outside production and
# to disabled when NODE_ENV=production unless explicitly set to true.
# API_DOCS_ENABLED=true
LOG_LEVEL=info

# --- Local Keycloak (infra/compose.yaml, realm infra/keycloak/import) ------------------
# Host port published on 127.0.0.1; the local issuer is http://127.0.0.1:<port>/realms/vertex.
KEYCLOAK_PORT=8080
# Master-realm administrator for the local admin console (http://127.0.0.1:<port>/admin). Both
# values are generated and applied only when the Keycloak volume is created; rotating them
# requires `pnpm infra:reset`.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=<generated:keycloak-admin-username>
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<generated:keycloak-admin-password>
# Client secrets of the realm's two clients; imported with the realm like the admin above.
KEYCLOAK_WEB_CLIENT_SECRET=<generated:keycloak-web-client-secret>
KEYCLOAK_PROVISIONER_CLIENT_SECRET=<generated:keycloak-provisioner-client-secret>
# Exact vertex-web URIs for local development (browser origin: the web dev server).
KEYCLOAK_WEB_REDIRECT_URI=http://127.0.0.1:4200/api/auth/callback
KEYCLOAK_WEB_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:4200/
# Called by Keycloak from inside its container, hence host.docker.internal.
KEYCLOAK_WEB_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3000/api/auth/backchannel-logout
# Realm SMTP settings for invitation and password-reset email: the local mail sink (Mailpit) on
# the Compose network. It accepts any credentials; the password is generated so the realm
# carries a secret as it does in production. Applied only when the Keycloak volume is created.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@vertex.test
KEYCLOAK_SMTP_USER=keycloak
KEYCLOAK_SMTP_PASSWORD=<generated:keycloak-smtp-password>
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false

# --- API identity provisioning (apps/api, docs/modules/iam.md Section 39) ------------------
# The realm issuer; must match KEYCLOAK_PORT. The API binds it to every provisioned identity.
KEYCLOAK_ISSUER_URL=http://127.0.0.1:8080/realms/vertex
KEYCLOAK_PROVISIONER_CLIENT_ID=vertex-provisioner
# Validity of an invitation link in seconds (300 to 604800; default 43200).
KEYCLOAK_INVITATION_LIFESPAN_SECONDS=43200

# --- Local mail sink (infra/compose.yaml) -----------------------------------------
# Web UI on 127.0.0.1:<port>: every invitation and reset email sent by the local realm.
MAILPIT_PORT=8025
