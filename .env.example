# Vertex OS local development. Run `pnpm env:setup` to generate the ignored .env.
POSTGRES_USER=vertex
POSTGRES_PASSWORD=<generated:postgres-password>
POSTGRES_DB=vertex_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vertex:<generated:postgres-password>@127.0.0.1:5432/vertex_os

API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Server-owned local application sessions.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=36000
AUTH_SESSION_RETENTION_DAYS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_SIGN_IN=10
AUTH_RATE_LIMIT_LOGOUT=30
AUTH_EVIDENCE_LIMIT=30
