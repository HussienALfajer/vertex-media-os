{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-main.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git -c * push * --force*)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh repo delete *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Bash(pnpm infra:reset *)",
      "Bash(* prisma migrate reset *)",
      "Bash(prisma migrate reset *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git -c * push * --force*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune *)",
      "PowerShell(docker system prune *)",
      "PowerShell(docker compose * down -v*)",
      "PowerShell(docker compose * down --volumes*)",
      "PowerShell(pnpm infra:reset *)",
      "PowerShell(* prisma migrate reset *)"
    ]
  }
}
