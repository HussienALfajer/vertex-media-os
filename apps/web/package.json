{
  "name": "@vertex-os/web",
  "version": "0.0.0",
  "private": true,
  "description": "Vertex OS browser application (React on Vite)",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@vertex-os/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "test": {},
      "build-lab": {
        "command": "vite build --mode lab",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-lab"
        ],
        "cache": true
      },
      "preview-lab": {
        "command": "vite preview --mode lab",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build-lab"
        ],
        "continuous": true
      }
    }
  }
}
