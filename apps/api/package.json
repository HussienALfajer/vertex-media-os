{
  "name": "@vertex-os/api",
  "version": "0.0.0",
  "private": true,
  "description": "Vertex OS backend API (NestJS on Fastify)",
  "type": "module",
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@vertex-os/audit": "workspace:*",
    "@vertex-os/audit-persistence": "workspace:*",
    "@vertex-os/database": "workspace:*",
    "@vertex-os/iam": "workspace:*",
    "@vertex-os/iam-keycloak": "workspace:*",
    "@vertex-os/iam-persistence": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "pino": "10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:backend"
    ],
    "targets": {
      "build": {
        "command": "tsc --build tsconfig.app.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "command": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      },
      "dev": {
        "options": {
          "cwd": "{projectRoot}",
          "parallel": true,
          "commands": [
            "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
            "node --enable-source-maps --env-file-if-exists=../../.env --watch-path=dist dist/main.js"
          ]
        },
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      },
      "openapi": {
        "command": "node dist/openapi/generate-openapi.js generated/openapi.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/generated"
        ]
      },
      "iam-bootstrap": {
        "command": "node --enable-source-maps --env-file-if-exists=../../.env dist/commands/iam-bootstrap.js",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "iam-sync-reference": {
        "command": "node --enable-source-maps --env-file-if-exists=../../.env dist/commands/iam-sync-reference.js",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "vitest"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          },
          "{workspaceRoot}/infra/**/*",
          "{workspaceRoot}/.env.example"
        ]
      },
      "test:integration": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
